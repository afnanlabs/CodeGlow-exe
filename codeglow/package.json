{
  "name": "codeglow",
  "displayName": "CodeGlow",
  "description": "A VS Code extension that provides persistent manual code highlighting and annotations for learning, reviewing, documenting, and explaining code.",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.120.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "codeglow.applyHighlight",
        "title": "CodeGlow: Apply Highlight"
      },
      {
        "command": "codeglow.removeHighlight",
        "title": "CodeGlow: Remove Highlight"
      },
      {
        "command": "codeglow.changeHighlightColor",
        "title": "CodeGlow: Change Highlight Color"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "codeglow.applyHighlight",
          "group": "codeglow@1"
        },
        {
          "command": "codeglow.removeHighlight",
          "group": "codeglow@2"
        },
        {
          "command": "codeglow.changeHighlightColor",
          "group": "codeglow@3"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.120.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}
